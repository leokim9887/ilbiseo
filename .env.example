# Google Calendar OAuth (서버 전용 — 브라우저에 노출하지 마세요)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 로컬: http://127.0.0.1:4317/api/google/callback
# 프로덕션(고정): https://fleet-nitrogen-6wxfp18.vercel.app/api/google/callback
# → DEPLOY_TARGET.md · store docs/production-url.md
GOOGLE_REDIRECT_URI=

# (선택) 토큰 쿠키 암호화 키. 없으면 GOOGLE_CLIENT_SECRET 해시 사용
TOKEN_ENCRYPTION_SECRET=

# 프로덕션: https://fleet-nitrogen-6wxfp18.vercel.app
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4317

# 브리핑 메일 — 네이버 SMTP (아버지 전용 goldage77@naver.com)
# 네이버 메일 → 환경설정 → POP3/IMAP → SMTP 사용 → 애플리케이션 비밀번호
NAVER_SMTP_PASSWORD=
# SMTP_PASS=   # NAVER_SMTP_PASSWORD 대신 사용 가능
# NAVER_SMTP_HOST=smtp.naver.com
# NAVER_SMTP_PORT=465
# NAVER_SMTP_USER=goldage77@naver.com
EMAIL_FROM="일비서 <goldage77@naver.com>"

# (선택) Resend 보조 — 사용하지 않음이 기본. 네이버 SMTP 우선.
# RESEND_API_KEY=

# Vercel Cron Bearer
CRON_SECRET=

# Vercel 크론용 스냅샷 + PC↔폰 동기화 저장 (Upstash Redis)
# 프로덕션 필수(동기화·브리핑 크론). 로컬은 없으면 .data/ 파일로 대체.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
