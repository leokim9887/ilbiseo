# Google Calendar OAuth (서버 전용 — 브라우저에 노출하지 마세요)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 예: http://127.0.0.1:4317/api/google/callback
# 배포: https://your-domain.vercel.app/api/google/callback
GOOGLE_REDIRECT_URI=

# (선택) 토큰 쿠키 암호화 키. 없으면 GOOGLE_CLIENT_SECRET 해시 사용
TOKEN_ENCRYPTION_SECRET=

# (선택) OAuth 콜백 후 돌아갈 앱 주소. 없으면 요청 origin / VERCEL_URL
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4317

# 브리핑 메일 (매일 08:00 KST)
RESEND_API_KEY=
# Resend에서 인증한 발신 주소 (EMAIL_FROM 권장, MAIL_FROM도 인식)
EMAIL_FROM="일비서 <you@your-domain.com>"
MAIL_FROM=
# Vercel Cron이 자동으로 Bearer로 붙입니다
CRON_SECRET=

# Vercel에서 크론 발송용 스냅샷 저장 (Upstash Redis 무료 티어)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
